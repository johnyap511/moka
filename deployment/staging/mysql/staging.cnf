[mysqld]
# Character set — must match Laravel's DB charset config
character-set-server  = utf8mb4
collation-server      = utf8mb4_unicode_ci

# InnoDB tuning (conservative for e2-medium with 4 GB RAM)
innodb_buffer_pool_size     = 256M
innodb_log_file_size        = 64M
innodb_flush_log_at_trx_commit = 2   # slight durability trade-off, fine for staging
innodb_flush_method         = O_DIRECT

# Connections
max_connections = 100
wait_timeout    = 300

# Slow query log — helpful for catching N+1 issues during staging tests
slow_query_log       = 1
slow_query_log_file  = /var/lib/mysql/slow.log
long_query_time      = 1

[client]
default-character-set = utf8mb4
