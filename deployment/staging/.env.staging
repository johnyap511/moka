# =============================================================================
# MOKA — Staging environment template
# IMPORTANT: Replace ALL placeholder values before deploying.
#            Never commit real secrets to version control.
#            Copy this file to .env.staging on the GCP VM and fill it in.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="MOKA Staging"
APP_ENV=staging
APP_DEBUG=true
APP_KEY=base64:REPLACE_WITH_OUTPUT_OF_php_artisan_key_generate

# Replace YOUR_GCP_EXTERNAL_IP with the VM's External IP from GCP Console
APP_URL=http://35.215.128.58:8080

# ---------------------------------------------------------------------------
# Logging — daily rotation, keep 14 days
# ---------------------------------------------------------------------------
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database — MySQL 8 (service name "db" resolves inside Docker network)
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=moka_staging
DB_USERNAME=moka_staging_user
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# Root password used by MySQL container healthcheck — keep separate from app user
DB_ROOT_PASSWORD=REPLACE_WITH_STRONG_ROOT_PASSWORD

# ---------------------------------------------------------------------------
# Cache & Session — Redis (service name "redis" resolves inside Docker network)
# ---------------------------------------------------------------------------
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=phpredis

# Separate Redis DB indexes to avoid key collisions
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3

# ---------------------------------------------------------------------------
# Mail — Use Mailtrap or similar for staging (no real emails sent)
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=REPLACE_WITH_MAILTRAP_USERNAME
MAIL_PASSWORD=REPLACE_WITH_MAILTRAP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=staging@moka.app
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# File storage — local disk for staging
# ---------------------------------------------------------------------------
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# Broadcasting (disabled for staging unless explicitly needed)
# ---------------------------------------------------------------------------
BROADCAST_DRIVER=log
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# ---------------------------------------------------------------------------
# Staging-specific flags (add app-level feature flags here)
# ---------------------------------------------------------------------------
# Uncomment to enable debug toolbar (Telescope, Debugbar, etc.)
# TELESCOPE_ENABLED=true
